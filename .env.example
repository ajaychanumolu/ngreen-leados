# Local development only. Copy to .env. Never commit .env or real credentials.

APP_ENV=local
ORGANIZATION_SLUG=ngreen

# Local SQLite so the app runs without Docker. Switch to Postgres when Compose is up.
DATABASE_URL=sqlite:///./data/local-leados.db
# DATABASE_URL=postgresql+psycopg://leados:local-dev-only@localhost:5432/ngreen_leados
REDIS_URL=redis://localhost:6379/0

# DEMO sign-in signs HS256 tokens with this secret. Change it before any shared deployment.
LOCAL_JWT_SECRET=local-dev-only-change-me
DEMO_AUTH_ENABLED=true

# Supabase Auth. Leave blank to keep DEMO sign-in.
# Dashboard: Project Settings → API Keys.
# Legacy tab: anon (public) and service_role (secret). Both start with eyJ.
# Newer tab: Publishable key and Secret key. The secret stays on the server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Table store. Supabase → Connect → ORMs → SQLAlchemy. Leave empty to keep the local file.
# SUPABASE_DB_URL=postgresql+psycopg://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Research provider. Empty means the DEMO adapter, not a silent live search.
SERPER_API_KEY=
RESEARCH_PROVIDER=demo
# inline runs the search in the API process. sync is for tests. redis needs Dramatiq.
RESEARCH_WORKER=inline
RESEARCH_BUDGET_CREDITS=5

# Model provider. mock reads only stored snippets.
# openai or groq is used when AI_PROVIDER and AI_API_KEY are both set. Leave the key empty here.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Live calling stays disabled until legal approval, a saved Vapi assistant,
# an imported caller number, and one named test contact are all set.
# Leave these empty. Do not put a real key in the browser.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VOICE_LIVE_ENABLED=false
VOICE_LEGAL_APPROVED=false
VOICE_TEST_CONTACT_ID=
VOICE_DAILY_CAP=1
VOICE_CONCURRENT_CAP=1
# Shared secret for voice webhooks. Empty rejects every webhook.
VOICE_WEBHOOK_SECRET=
